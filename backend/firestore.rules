rules_version = '2';

// Each signed-in student can read and write their own memory and nothing else.
// The backend with a service account is not bound by these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /students/{studentId} {
      allow read, write: if request.auth != null && request.auth.uid == studentId;
      match /memory/{section} {
        allow read, write: if request.auth != null && request.auth.uid == studentId
                           && section in ['profile', 'learned'];
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
