{
  "name": "bearrok-dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "app": "vite build --base=./ && electron .",
    "app:dev": "ELECTRON_START_URL=http://localhost:5173 electron .",
    "app:package": "vite build --base=./ && electron-packager . BearRok --icon=electron/icon.icns --out=release --overwrite --prune=true --ignore=\"^/(src|public|release|index\\.html|vite\\.config\\.ts|tsconfig\\.json|README\\.md)\" --ignore=\"^/node_modules\""
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "firebase": "^13.4.0",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "productName": "BearRok",
  "version": "0.1.0",
  "main": "electron/main.cjs"
}
